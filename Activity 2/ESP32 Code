void setup() {
  Serial.begin(115200);

  pinMode(RED, OUTPUT);
  pinMode(GREEN, OUTPUT);
  pinMode(BLUE, OUTPUT);

  setColor(0, 0, 0);

  WiFi.mode(WIFI_AP);
  WiFi.softAP(ssid, password);

  Serial.println("WiFi Started");
  Serial.println(WiFi.softAPIP());

  server.on("/", handleHome);
  server.on("/set", handleCommand);

  server.begin();
}

void loop() {
  server.handleClient();

  unsigned long currentTime = millis();

  if (mode != 0 &&
      currentTime - previousTime >= interval) {

    previousTime = currentTime;

    if (mode == 1) {
      switch (state) {
        case 0: setColor(1, 0, 0); break;
        case 1: setColor(0, 1, 0); break;
        case 2: setColor(0, 0, 1); break;
        case 3: setColor(1, 1, 0); break;
        case 4: setColor(1, 0, 1); break;
        case 5: setColor(0, 1, 1); break;
      }

      state = (state + 1) % 6;
    }

    else if (mode == 2) {
      setColor(state, state, state);
      state = !state;
    }
  }
}
