
#include <WiFi.h>
#include <WebServer.h>

const char* ssid = "IEEE-Light-Control";
const char* password = "12345678";

const int RED = 25;
const int GREEN = 26;
const int BLUE = 27;

WebServer server(80);

int mode = 0;
int state = 0;

unsigned long previousTime = 0;
unsigned long interval = 500;

void setColor(int r, int g, int b) {
  digitalWrite(RED, r);
  digitalWrite(GREEN, g);
  digitalWrite(BLUE, b);
}

void handleCommand() {
  String cmd = server.arg("cmd");
  cmd.toLowerCase();

  mode = 0;
  state = 0;

  if (cmd == "red")
    setColor(1, 0, 0);

  else if (cmd == "green")
    setColor(0, 1, 0);

  else if (cmd == "blue")
    setColor(0, 0, 1);

  else if (cmd == "yellow")
    setColor(1, 1, 0);

  else if (cmd == "purple")
    setColor(1, 0, 1);

  else if (cmd == "cyan")
    setColor(0, 1, 1);

  else if (cmd == "white")
    setColor(1, 1, 1);

  else if (cmd == "off")
    setColor(0, 0, 0);

  else if (cmd == "party") {
    mode = 1;
    interval = 300;
  }

  else if (cmd == "blink") {
    mode = 2;
    interval = 500;
  }

  else {
    setColor(0, 0, 0);
    server.send(400, "text/plain", "Invalid command");
    return;
  }

  Serial.println("Command: " + cmd);
  server.send(200, "text/plain", "Success: " + cmd);
}

